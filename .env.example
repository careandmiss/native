# mcp-ppt-native-fill environment variables (copy to .env to use).

# Override the default ppt-master skill install path. Leave blank to use the
# platform default (Windows: C:\Users\<user>\.claude\skills\ppt-master ;
# POSIX: ~/.claude/skills/ppt-master).
# PPT_MASTER_SKILL_DIR=C:/Users/Administrator/.claude/skills/ppt-master

# Override the Python interpreter used to spawn ppt-master scripts.
# Leave blank to autodetect (sys.executable first, then PATH lookup).
# PPT_MASTER_PYTHON=C:/Python313/python.exe
# MCP_PPT_PYTHON=C:/Python313/python.exe

# Logging level for the MCP server (DEBUG / INFO / WARNING / ERROR).
# MCP_NATIVE_FILL_LOG_LEVEL=INFO

# --- Optional LLM planning phase (server-side markdown -> content_mapping) ---
# Only used when native_fill is invoked with both
#   arguments.content_markdown  AND  options.llm_plan = true
# Without these set, the LLM phase is skipped entirely (no impact on the
# caller-supplied content_mapping path).
#
# Provider: "anthropic" (Messages API) or "openai_compatible"
# (OpenAI / Ollama / llama.cpp's server / vLLM / any /v1/chat/completions
# endpoint).
# MCP_LLM_PROVIDER=anthropic
# MCP_LLM_API_KEY=
# MCP_LLM_BASE_URL=                 # default: Anthropic api.anthropic.com
#                                  #         OpenAI    api.openai.com
# MCP_LLM_MODEL=                    # default: claude-sonnet-5-20250929 (anthropic)
#                                  #         gpt-5-mini (openai_compatible)
# MCP_LLM_MAX_TOKENS=4096
# MCP_LLM_TIMEOUT_S=60
